<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\apiFestivos.aplicacion\apiFestivos.aplicacion.csproj" />
    <ProjectReference Include="..\apiFestivos.infraestructura\apiFestivos.infraestructura.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Se conserva el proyecto vacío original, sin incluir sus obj/bin en la API. -->
    <Compile Remove="apiFestivos.core\**\*.cs" />
    <Content Remove="apiFestivos.core\**" />
    <None Remove="apiFestivos.core\**" />
  </ItemGroup>
</Project>
